<!-- Atelier 5 : mise en forme de type tableau avec les éléments simples (texte statique, champ texte, ligne, rectangle, ellipse, cadre) -->
<jasperReport name="Atelier5_ElementsSimples" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a5000000-0000-4000-8000-000000000001">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0"/>
	<query language="sql"><![CDATA[SELECT D.ID AS DOCUMENT,
       A.FIRSTNAME || ' ' || A.LASTNAME AS CLIENT,
       PO.POSITIONNO AS LIGNE,
       P.NAME AS PRODUIT,
       PO.QUANTITY AS QUANTITE,
       PO.PRICE AS PRIX,
       PO.QUANTITY * PO.PRICE AS TOTAL
FROM POSITIONS PO
JOIN DOCUMENT D ON D.ID = PO.DOCUMENTID
JOIN PRODUCT P ON P.ID = PO.PRODUCTID
JOIN ADDRESS A ON A.ID = D.ADDRESSID
WHERE D.ID <= 5
ORDER BY D.ID, PO.POSITIONNO]]></query>
	<field name="DOCUMENT" class="java.lang.Integer"/>
	<field name="CLIENT" class="java.lang.String"/>
	<field name="LIGNE" class="java.lang.Integer"/>
	<field name="PRODUIT" class="java.lang.String"/>
	<field name="QUANTITE" class="java.lang.Integer"/>
	<field name="PRIX" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<title height="80" splitType="Stretch">
		<element kind="rectangle" uuid="a5000000-0000-4000-8000-000000000002" x="0" y="0" width="555" height="50" backcolor="#E8EEF5" mode="Opaque" radius="8">
			<pen lineWidth="1.0" lineColor="#1F3A5F"/>
		</element>
		<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000003" x="10" y="5" width="535" height="26" fontSize="18.0" bold="true" vTextAlign="Middle" forecolor="#1F3A5F">
			<text><![CDATA[Détail des commandes clients]]></text>
		</element>
		<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000004" x="10" y="30" width="535" height="16" italic="true" vTextAlign="Middle">
			<text><![CDATA[Lignes de commande des documents n° 1 à 5 – base d'exemple]]></text>
		</element>
		<element kind="textField" uuid="a5000000-0000-4000-8000-000000000005" x="355" y="56" width="200" height="16" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" pattern="'Édité le' dd/MM/yyyy">
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
	</title>
	<columnHeader height="22" splitType="Stretch">
		<element kind="frame" uuid="a5000000-0000-4000-8000-000000000006" x="0" y="0" width="555" height="22" backcolor="#D9D9D9" mode="Opaque">
			<box>
				<pen lineWidth="0.75"/>
			</box>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000007" x="0" y="0" width="45" height="22" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<text><![CDATA[Doc.]]></text>
			</element>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000008" x="45" y="0" width="120" height="22" bold="true" vTextAlign="Middle">
				<box leftPadding="4"/>
				<text><![CDATA[Client]]></text>
			</element>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000009" x="165" y="0" width="40" height="22" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<text><![CDATA[Ligne]]></text>
			</element>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000010" x="205" y="0" width="170" height="22" bold="true" vTextAlign="Middle">
				<box leftPadding="4"/>
				<text><![CDATA[Produit]]></text>
			</element>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000011" x="375" y="0" width="50" height="22" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<box rightPadding="4"/>
				<text><![CDATA[Qté]]></text>
			</element>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000012" x="425" y="0" width="60" height="22" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<box rightPadding="4"/>
				<text><![CDATA[Prix unit.]]></text>
			</element>
			<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000013" x="485" y="0" width="70" height="22" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<box rightPadding="4"/>
				<text><![CDATA[Total]]></text>
			</element>
		</element>
	</columnHeader>
	<detail>
		<band height="18" splitType="Prevent">
			<element kind="frame" uuid="a5000000-0000-4000-8000-000000000014" x="0" y="0" width="555" height="18" stretchType="ContainerHeight">
				<box>
					<pen lineWidth="0.5" lineColor="#808080"/>
				</box>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000015" x="0" y="0" width="45" height="18" hTextAlign="Center" vTextAlign="Middle" stretchType="ContainerHeight">
					<box><rightPen lineWidth="0.5" lineColor="#808080"/></box>
					<expression><![CDATA[$F{DOCUMENT}]]></expression>
				</element>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000016" x="45" y="0" width="120" height="18" vTextAlign="Middle" stretchType="ContainerHeight">
					<box leftPadding="4"><rightPen lineWidth="0.5" lineColor="#808080"/></box>
					<expression><![CDATA[$F{CLIENT}]]></expression>
				</element>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000017" x="165" y="0" width="40" height="18" hTextAlign="Center" vTextAlign="Middle" stretchType="ContainerHeight">
					<box><rightPen lineWidth="0.5" lineColor="#808080"/></box>
					<expression><![CDATA[$F{LIGNE}]]></expression>
				</element>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000018" x="205" y="0" width="170" height="18" vTextAlign="Middle" textAdjust="StretchHeight">
					<box leftPadding="4" rightPadding="14"><rightPen lineWidth="0.5" lineColor="#808080"/></box>
					<expression><![CDATA[$F{PRODUIT}]]></expression>
				</element>
				<element kind="ellipse" uuid="a5000000-0000-4000-8000-000000000019" x="362" y="5" width="8" height="8" backcolor="#2E8B57" forecolor="#2E8B57" mode="Opaque">
					<printWhenExpression><![CDATA[$F{QUANTITE} >= 10]]></printWhenExpression>
				</element>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000020" x="375" y="0" width="50" height="18" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0" stretchType="ContainerHeight">
					<box rightPadding="4"><rightPen lineWidth="0.5" lineColor="#808080"/></box>
					<expression><![CDATA[$F{QUANTITE}]]></expression>
				</element>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000021" x="425" y="0" width="60" height="18" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00 €" stretchType="ContainerHeight">
					<box rightPadding="4"><rightPen lineWidth="0.5" lineColor="#808080"/></box>
					<expression><![CDATA[$F{PRIX}]]></expression>
				</element>
				<element kind="textField" uuid="a5000000-0000-4000-8000-000000000022" x="485" y="0" width="70" height="18" bold="true" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00 €" stretchType="ContainerHeight">
					<box rightPadding="4"/>
					<expression><![CDATA[$F{TOTAL}]]></expression>
				</element>
			</element>
		</band>
	</detail>
	<columnFooter height="20" splitType="Stretch">
		<element kind="ellipse" uuid="a5000000-0000-4000-8000-000000000023" x="0" y="6" width="8" height="8" backcolor="#2E8B57" forecolor="#2E8B57" mode="Opaque"/>
		<element kind="staticText" uuid="a5000000-0000-4000-8000-000000000024" x="12" y="2" width="300" height="16" fontSize="8.0" italic="true" vTextAlign="Middle">
			<text><![CDATA[Pastille verte : quantité commandée supérieure ou égale à 10]]></text>
		</element>
	</columnFooter>
	<pageFooter height="24" splitType="Stretch">
		<element kind="line" uuid="a5000000-0000-4000-8000-000000000025" x="0" y="2" width="555" height="1" forecolor="#1F3A5F">
			<pen lineWidth="1.0"/>
		</element>
		<element kind="textField" uuid="a5000000-0000-4000-8000-000000000026" x="455" y="6" width="100" height="16" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
