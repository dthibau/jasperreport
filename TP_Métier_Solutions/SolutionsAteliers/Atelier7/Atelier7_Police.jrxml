<!-- Atelier 7 : annuaire en police Gentium (extension de police déclarée dans Studio, exportée en jar) -->
<jasperReport name="Atelier7_Police" language="java" columnCount="2" pageWidth="595" pageHeight="842" columnWidth="270" columnSpacing="15" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a3000000-0000-4000-8000-000000000001">
	<style name="Base" default="true" fontName="Gentium" fontSize="12.0" pdfEncoding="Identity-H" pdfEmbedded="true"/>
	<query language="sql"><![CDATA[SELECT FIRSTNAME, LASTNAME
