<!-- Atelier 9 : page de garde (Title on a new page), en-têtes répétés, pas de coupure d'enregistrement, résumé sur une nouvelle page, Page x sur y -->
<jasperReport name="Atelier9_Pagination" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" titleNewPage="true" summaryNewPage="true" summaryWithPageHeaderAndFooter="true" whenNoDataType="NoDataSection" uuid="a9000000-0000-4000-8000-000000000001">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0"/>
	<style name="Entete" bold="true" mode="Opaque" backcolor="#D9D9D9" vTextAlign="Middle">
		<box padding="2" leftPadding="4" rightPadding="4"><pen lineWidth="0.75"/></box>
	</style>
	<style name="Donnees" vTextAlign="Top">
		<box padding="2" leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#808080"/></box>
	</style>
	<parameter name="P_PAYS" class="java.lang.String">
		<description><![CDATA[Pays de livraison]]></description>
		<defaultValueExpression><![CDATA["Germany"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT O.ORDERID, O.ORDERDATE, O.SHIPNAME, O.SHIPADDRESS, O.SHIPCITY, O.FREIGHT
FROM ORDERS O
WHERE O.SHIPCOUNTRY = $P{P_PAYS}
ORDER BY O.SHIPCITY, O.ORDERDATE]]></query>
	<field name="ORDERID" class="java.lang.Integer"/>
	<field name="ORDERDATE" class="java.sql.Timestamp"/>
	<field name="SHIPNAME" class="java.lang.String"/>
	<field name="SHIPADDRESS" class="java.lang.String"/>
	<field name="SHIPCITY" class="java.lang.String"/>
	<field name="FREIGHT" class="java.math.BigDecimal"/>
	<variable name="TOTAL_PORT" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{FREIGHT}]]></expression>
	</variable>
	<title height="700" splitType="Stretch">
		<element kind="image" uuid="a9000000-0000-4000-8000-000000000002" x="177" y="120" width="200" height="60" scaleImage="RetainShape" hImageAlign="Center">
			<expression><![CDATA["logo.png"]]></expression>
		</element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000003" x="0" y="260" width="555" height="50" fontSize="28.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[Registre des commandes]]></text>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000004" x="0" y="310" width="555" height="30" fontSize="16.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["Pays de livraison : " + $P{P_PAYS}]]></expression>
		</element>
		<element kind="line" uuid="a9000000-0000-4000-8000-000000000005" x="150" y="350" width="255" height="1"><pen lineWidth="1.5"/></element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000006" x="0" y="360" width="555" height="20" fontSize="11.0" hTextAlign="Center" pattern="'Document généré le' EEEE d MMMM yyyy 'à' HH:mm">
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000007" x="0" y="385" width="555" height="20" fontSize="11.0" hTextAlign="Center" evaluationTime="Report">
			<expression><![CDATA[$V{REPORT_COUNT} + " commandes – " + $V{PAGE_NUMBER} + " pages"]]></expression>
		</element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000008" x="0" y="660" width="555" height="30" fontSize="8.0" italic="true" hTextAlign="Center" vTextAlign="Bottom">
			<text><![CDATA[Formation JasperStudio – atelier 9 – la bande Title occupe une page entière grâce à la propriété Title on a new page]]></text>
		</element>
	</title>
	<pageHeader height="30" splitType="Stretch">
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000009" x="0" y="4" width="400" height="20" fontSize="12.0" bold="true" vTextAlign="Middle">
			<expression><![CDATA["Registre des commandes – " + $P{P_PAYS}]]></expression>
		</element>
		<element kind="image" uuid="a9000000-0000-4000-8000-000000000010" x="455" y="2" width="100" height="24" scaleImage="RetainShape" hImageAlign="Right">
			<expression><![CDATA["logo.png"]]></expression>
		</element>
		<element kind="line" uuid="a9000000-0000-4000-8000-000000000011" x="0" y="28" width="555" height="1"/>
	</pageHeader>
	<columnHeader height="22" splitType="Stretch">
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000012" x="0" y="0" width="60" height="22" style="Entete" hTextAlign="Right"><text><![CDATA[N°]]></text></element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000013" x="60" y="0" width="70" height="22" style="Entete" hTextAlign="Center"><text><![CDATA[Date]]></text></element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000014" x="130" y="0" width="100" height="22" style="Entete"><text><![CDATA[Ville]]></text></element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000015" x="230" y="0" width="140" height="22" style="Entete"><text><![CDATA[Client]]></text></element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000016" x="370" y="0" width="125" height="22" style="Entete"><text><![CDATA[Adresse]]></text></element>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000017" x="495" y="0" width="60" height="22" style="Entete" hTextAlign="Right"><text><![CDATA[Port (€)]]></text></element>
	</columnHeader>
	<detail>
		<band height="18" splitType="Prevent">
			<element kind="textField" uuid="a9000000-0000-4000-8000-000000000018" x="0" y="0" width="60" height="18" style="Donnees" hTextAlign="Right" stretchType="ElementGroupHeight">
				<expression><![CDATA[$F{ORDERID}]]></expression>
			</element>
			<element kind="textField" uuid="a9000000-0000-4000-8000-000000000019" x="60" y="0" width="70" height="18" style="Donnees" hTextAlign="Center" pattern="dd/MM/yyyy" stretchType="ElementGroupHeight">
				<expression><![CDATA[$F{ORDERDATE}]]></expression>
			</element>
			<element kind="textField" uuid="a9000000-0000-4000-8000-000000000020" x="130" y="0" width="100" height="18" style="Donnees" stretchType="ElementGroupHeight">
				<expression><![CDATA[$F{SHIPCITY}]]></expression>
			</element>
			<element kind="textField" uuid="a9000000-0000-4000-8000-000000000021" x="230" y="0" width="140" height="18" style="Donnees" textAdjust="StretchHeight" stretchType="ElementGroupHeight">
				<expression><![CDATA[$F{SHIPNAME}]]></expression>
			</element>
			<element kind="textField" uuid="a9000000-0000-4000-8000-000000000022" x="370" y="0" width="125" height="18" style="Donnees" textAdjust="StretchHeight" stretchType="ElementGroupHeight">
				<expression><![CDATA[$F{SHIPADDRESS}]]></expression>
			</element>
			<element kind="textField" uuid="a9000000-0000-4000-8000-000000000023" x="495" y="0" width="60" height="18" style="Donnees" hTextAlign="Right" pattern="#,##0.00" stretchType="ElementGroupHeight">
				<expression><![CDATA[$F{FREIGHT}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="24" splitType="Stretch">
		<element kind="line" uuid="a9000000-0000-4000-8000-000000000025" x="0" y="2" width="555" height="1"/>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000026" x="0" y="6" width="250" height="16" fontSize="8.0" vTextAlign="Middle" pattern="'Édité le' dd/MM/yyyy 'à' HH:mm">
			<expression><![CDATA[new java.util.Date()]]></expression>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000027" x="395" y="6" width="100" height="16" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " sur"]]></expression>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000028" x="495" y="6" width="60" height="16" fontSize="8.0" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<lastPageFooter height="40" splitType="Stretch">
		<element kind="line" uuid="a9000000-0000-4000-8000-000000000029" x="0" y="2" width="555" height="1"/>
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000030" x="0" y="6" width="395" height="30" fontSize="8.0" italic="true">
			<text><![CDATA[Fin du document. Ce pied de page (Last Page Footer) n'apparaît que sur la dernière page et remplace le pied de page courant.]]></text>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000031" x="395" y="6" width="100" height="16" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " sur"]]></expression>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000032" x="495" y="6" width="60" height="16" fontSize="8.0" vTextAlign="Middle" evaluationTime="Report">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</lastPageFooter>
	<summary height="90" splitType="Stretch">
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000033" x="0" y="10" width="555" height="24" fontSize="14.0" bold="true">
			<text><![CDATA[Récapitulatif]]></text>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000034" x="0" y="40" width="300" height="18" fontSize="10.0">
			<expression><![CDATA["Nombre de commandes : " + $V{REPORT_COUNT}]]></expression>
		</element>
		<element kind="textField" uuid="a9000000-0000-4000-8000-000000000035" x="0" y="60" width="300" height="18" fontSize="10.0" pattern="'Total des frais de port : ' #,##0.00 '€'">
			<expression><![CDATA[$V{TOTAL_PORT}]]></expression>
		</element>
	</summary>
	<noData height="60" splitType="Stretch">
		<element kind="staticText" uuid="a9000000-0000-4000-8000-000000000036" x="0" y="20" width="555" height="20" italic="true" hTextAlign="Center">
			<text><![CDATA[Aucune commande pour ce pays]]></text>
		</element>
	</noData>
</jasperReport>
